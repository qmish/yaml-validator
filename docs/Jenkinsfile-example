// Пример Jenkinsfile с шагом валидации YAML
// Скопируйте в корень репозитория как Jenkinsfile или используйте как референс.
// Требуется: Jenkins с Go plugin (go-1.24+) и yaml-validator в репозитории.

pipeline {
    agent any

    tools {
        go 'go-1.24'
    }

    stages {
        stage('Build yaml-validator') {
            steps {
                sh 'go build -o yaml-validator .'
            }
        }
        stage('Validate YAML') {
            steps {
                sh '''
                    FILES=$(find . -type f \\( -name "*.yaml" -o -name "*.yml" \\) ! -path "*/node_modules/*" ! -path "*/.git/*" 2>/dev/null || true)
                    if [ -n "$FILES" ]; then
                        echo "$FILES" | xargs ./yaml-validator validate -o severity --jobs 4
                    else
                        echo "No YAML files found"
                    fi
                '''
            }
        }
    }
}
