{
  "name": "yaml-validator",
  "displayName": "YAML Validator",
  "description": "YAML validation via yaml-validator LSP",
  "version": "0.1.0",
  "publisher": "qmish",
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Linters", "Formatters"],
  "activationEvents": ["onLanguage:yaml"],
  "main": "./out/extension.js",
  "scripts": { "compile": "tsc -p ./", "watch": "tsc -watch -p ./" },
  "dependencies": { "vscode-languageclient": "^9.0.1" },
  "devDependencies": { "@types/vscode": "^1.74.0", "typescript": "^5.0.0" },
  "contributes": {
    "configuration": {
      "title": "YAML Validator",
      "properties": {
        "yamlValidator.serverPath": {
          "type": "string",
          "default": "yaml-validator",
          "description": "Path to yaml-validator binary"
        }
      }
    }
  }
}
